# Environment Variables
# Copy this file to .env.local and fill in the values

# AMap JS API
VITE_AMAP_KEY=your_amap_key_here
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here

# Mapbox public token
# Get yours at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Optional: voice ASR/TTS for onboarding guide
VITE_SILICONFLOW_API_KEY=your_siliconflow_api_key_here
